# --- Copernicus Data Space Ecosystem (CDSE) ---
# Registrace: https://dataspace.copernicus.eu (zdarma)
# OAuth2 client: Dashboard -> Settings -> OAuth clients -> Create new client
# (client_credentials grant, ne user login)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_STATS_API_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics
CDSE_CATALOG_URL=https://sh.dataspace.copernicus.eu/api/v1/catalog/1.0.0/search

# --- Supabase (service role — bypassuje RLS, ownership checks jsou v kódu) ---
SUPABASE_URL=https://[project].supabase.co
SUPABASE_SERVICE_KEY=[service-role-key]
SUPABASE_STORAGE_BUCKET=geotiffs

# --- Shared secret mezi Next.js a Python (Next.js -> Python proxy auth) ---
# Povinný. Bez něj engine vrací 503 na všechno (fail-closed, api/middleware.py).
# Vygeneruj: openssl rand -hex 32
NEXT_JS_SECRET=[stejný náhodný 32+ znakový string jako v phasq_app/.env.local]
# Jen lokální vývoj bez secretu: ENGINE_ALLOW_NO_AUTH=1 (funguje jen s ENVIRONMENT=development)
# ENGINE_ALLOW_NO_AUTH=

# --- App ---
PORT=8000
ENVIRONMENT=development

# --- Climate Data Store (ERA5-Land) - jiný účet než CDSE, viz ADR-012 ---
CDS_API_KEY=
